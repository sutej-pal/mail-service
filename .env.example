PORT=3000

# Optional: set this to your app domain.
ALLOWED_ORIGIN=*

# Optional API key protection. If set, clients must send x-api-key.
MAIL_API_KEY=replace-with-strong-key

# Verified sender address (or Resend test sender: onboarding@resend.dev).
MAIL_FROM=onboarding@resend.dev

# --- Preferred on Render Free (SMTP ports 25/465/587 are blocked) ---
# Create a free key at https://resend.com — sends over HTTPS :443.
RESEND_API_KEY=

# --- SMTP fallback (works on paid Render / non-blocked hosts) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example-user
SMTP_PASS=example-password
