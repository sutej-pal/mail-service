PORT=3000

# Optional: set this to your app domain.
ALLOWED_ORIGIN=*

# Optional API key protection. If set, clients must send x-api-key.
MAIL_API_KEY=replace-with-strong-key

# Verified sender address (e.g. your Gmail address).
MAIL_FROM=you@example.com

# Optional: verify Supabase Send Email Hook signatures.
# Value format from Supabase dashboard: v1,whsec_<base64_secret>
SEND_EMAIL_HOOK_SECRET=

# --- SMTP (required) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example-user
SMTP_PASS=example-password
