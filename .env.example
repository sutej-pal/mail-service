PORT=3000

# Optional: set this to your app domain.
ALLOWED_ORIGIN=*

# Public origin for absolute URLs in outbound email HTML (logo, etc.).
# Use your stable production host; do not rely on per-deploy VERCEL_URL.
PUBLIC_BASE_URL=https://splitease-server-eight.vercel.app

# Rate limits (per IP; mail endpoints also key on recipient email)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=120
# RATE_LIMIT_SEND_MAIL_MAX=10

# SMTP (SMTP_USER is also used as the From address)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example-user
SMTP_PASS=example-password
